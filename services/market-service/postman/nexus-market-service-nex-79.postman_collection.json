{
  "info": {
    "name": "Nexus Market Service - NEX-79",
    "description": "Manual validation collection for NEX-79: synchronize market data from provider.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8884"
    }
  ],
  "item": [
    {
      "name": "Synchronize market data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symbols\": [\"AAPL\", \"MSFT\", \"TSLA\"],\n  \"requestedBy\": \"system@nexus.local\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/quotes/sync",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "quotes", "sync"]
        },
        "description": "Synchronizes quotes and persists latest cache, history and sync event."
      }
    }
  ]
}

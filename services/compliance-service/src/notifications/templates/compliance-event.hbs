<html>
  <body style='font-family:Arial,sans-serif;background:#f8fafc;margin:0;padding:32px;color:#0f172a;'>
    <div style='max-width:620px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-radius:18px;overflow:hidden;'>
      <div style='background:#0f172a;color:#f8fafc;padding:24px 28px;'>
        <p style='margin:0 0 8px;font-size:13px;letter-spacing:.08em;text-transform:uppercase;'>{{appName}}</p>
        <h1 style='margin:0;font-size:26px;'>{{subject}}</h1>
      </div>
      <div style='padding:28px;'>
        <p style='margin:0 0 18px;font-size:16px;'>Hello <strong>{{fullName}}</strong>,</p>
        <p style='margin:0 0 22px;font-size:16px;line-height:1.55;'>{{message}}</p>
        <p style='margin:0;color:#475569;font-size:14px;'>Event time: {{occurredAtDisplay}}</p>
      </div>
    </div>
  </body>
</html>

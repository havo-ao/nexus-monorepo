<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <title>{{headline}}</title>
  </head>
  <body style='margin:0;padding:0;background:#fff1f2;font-family:Arial,sans-serif;color:#1f2937;'>
    <div style='max-width:640px;margin:0 auto;padding:32px 20px;'>
      <div style='background:#7f1d1d;color:#fff7ed;padding:28px 32px;border-radius:24px 24px 0 0;'>
        <p style='margin:0 0 8px;font-size:12px;letter-spacing:0.12em;text-transform:uppercase;color:#fecdd3;'>{{appName}}</p>
        <h1 style='margin:0;font-size:30px;line-height:1.2;'>{{headline}}</h1>
      </div>
      <div style='background:#ffffff;padding:32px;border-radius:0 0 24px 24px;box-shadow:0 20px 45px rgba(127,29,29,0.08);'>
        <p style='margin:0 0 16px;font-size:16px;'>Hi {{fullName}},</p>
        <p style='margin:0 0 16px;font-size:16px;line-height:1.6;'>{{intro}}</p>
        <p style='margin:0 0 16px;font-size:16px;line-height:1.6;'>For security reasons, your account was temporarily locked at <strong>{{occurredAtDisplay}} UTC</strong> for user <strong>@{{username}}</strong>.</p>
        <p style='margin:0 0 24px;font-size:16px;line-height:1.6;'>You will be able to attempt to access the application again in 10 minutes after that time. This alert was sent to <strong>{{recipientEmail}}</strong>.</p>
        <p style='margin:0 0 8px;font-size:13px;line-height:1.6;color:#64748b;'>Technical reference for the event: {{occurredAt}}</p>
        <p style='margin:24px 0 0;font-size:14px;line-height:1.6;color:#475569;'>{{supportMessage}}</p>
        <p style='margin:32px 0 0;font-size:12px;line-height:1.6;color:#94a3b8;'>{{appName}} Compliance Team · {{year}}</p>
      </div>
    </div>
  </body>
</html>
